GMAIL_EMAIL=
GMAIL_PASSWORD=

# Vault path (default: current directory)
VAULT_PATH=

# Poll interval in seconds (default: 300 = 5 minutes)
GMAIL_POLL_INTERVAL=

# Run browser headless (default: true)
# Set to false for initial login/2FA setup, then switch back to true
# GMAIL_HEADLESS=true

GMAIL_HEADLESS=

# Logic Orchestrator (brain) Configuration
# Required: OpenAI API key for GPT-4o inference
OPENAI_API_KEY=

# GPT-5O model for email classification and draft generation
OPENAI_MODEL=

# Odoo Accounting Integration (Gold Phase 2)
# Required for all Odoo operations — never commit real values
ODOO_URL=https://your-odoo-instance.example.com
ODOO_DB=your_database_name
ODOO_USER=your_odoo_login@example.com
ODOO_API_KEY=your_odoo_api_key_here

# Optional: max reconciliation proposals per scan run (default: 20)
# ODOO_RECONCILE_BATCH=20

