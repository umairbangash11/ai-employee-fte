GMAIL_EMAIL=
GMAIL_PASSWORD=

# Vault path (default: current directory)
VAULT_PATH=

# Poll interval in seconds (default: 300 = 5 minutes)
GMAIL_POLL_INTERVAL=

# Run browser headless (default: true)
# Set to false for initial login/2FA setup, then switch back to true
# GMAIL_HEADLESS=true

GMAIL_HEADLESS=

# Logic Orchestrator (brain) Configuration
# Required: OpenAI API key for GPT-4o inference
OPENAI_API_KEY=

# GPT-5O model for email classification and draft generation
OPENAI_MODEL=

