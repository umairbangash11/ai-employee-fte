# =============================================================================
# AI Employee FTE - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env_example .env
#
# IMPORTANT: Never commit .env to version control!
# =============================================================================

# =============================================================================
# CORE SETTINGS (Required)
# =============================================================================

# Path to your Obsidian vault (or any folder to use as workspace)
VAULT_PATH=/path/to/your/obsidian/vault

# OpenAI API key for AI features (email triage, draft generation)
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI model to use (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# =============================================================================
# GMAIL WATCHER
# =============================================================================

# Path to OAuth credentials.json from Google Cloud Console
# Download from: https://console.cloud.google.com/apis/credentials
GMAIL_CREDENTIALS_PATH=./secrets/gmail/credentials.json

# Path to store OAuth token (auto-generated after first auth)
GMAIL_TOKEN_PATH=./secrets/gmail/token.json

# Path to deduplication state file
GMAIL_STATE_PATH=./.watcher-state/gmail-api.json

# Poll interval in seconds (minimum: 60)
GMAIL_POLL_INTERVAL=120

# Maximum emails to fetch per poll
GMAIL_MAX_FETCH=100

# =============================================================================
# WHATSAPP WATCHER
# =============================================================================

# Poll interval in seconds (default: 60)
WHATSAPP_POLL_INTERVAL=60

# Comma-separated urgency keywords that trigger routing to Needs_Action
WHATSAPP_URGENCY_KEYWORDS=URGENT,ASAP,emergency,call me,time-sensitive

# Page load timeout in milliseconds (default: 30000)
WHATSAPP_PAGE_TIMEOUT=30000

# =============================================================================
# ORCHESTRATOR (Brain)
# =============================================================================

# Poll interval for orchestrator in seconds (default: 1.0)
BRAIN_POLL_INTERVAL=1.0

# =============================================================================
# EMAIL REASONER
# =============================================================================

# Path to reasoner state file (optional)
REASONER_STATE_PATH=./.watcher-state/reasoner.json

# Confidence threshold for classification (default: 0.6)
# Below this threshold, emails are marked as informational
REASONER_CONFIDENCE_THRESHOLD=0.6

# =============================================================================
# ROUTER
# =============================================================================

# SLA threshold in hours before routing to Needs_Action (default: 24)
ROUTER_SLA_HOURS=24

# Comma-separated urgency keywords (optional, has defaults)
ROUTER_URGENCY_KEYWORDS=urgent,asap,deadline,critical,time-sensitive,immediate,priority,emergency,action required

# Enable verbose logging for router (default: false)
ROUTER_VERBOSE_LOG=false

# =============================================================================
# HITL APPROVAL
# =============================================================================

# Path to approval state file (optional)
HITL_STATE_PATH=./.watcher-state/approvals.json

# Enable verbose mode (default: false)
HITL_VERBOSE=false

# =============================================================================
# LINKEDIN PUBLISHER
# =============================================================================

# Path to Playwright session storage (optional)
LINKEDIN_SESSION_PATH=./.watcher-state/linkedin/session

# Path to publisher state file (optional)
LINKEDIN_STATE_PATH=./.watcher-state/linkedin/publisher.json

# Run browser in headless mode (default: true)
# Set to false for initial authentication
LINKEDIN_HEADLESS=true

# Poll interval in seconds for poll mode (default: 30)
LINKEDIN_POLL_INTERVAL=30

# Detection mode: 'watch' or 'poll' (default: watch)
LINKEDIN_DETECTION_MODE=watch

# Enable verbose logging (default: false)
LINKEDIN_VERBOSE=false

# =============================================================================
# FACEBOOK PUBLISHER
# =============================================================================

# Path to Playwright session storage (optional)
FB_SESSION_PATH=./.watcher-state/facebook

# Poll interval in seconds for poll mode (default: 30)
FB_POLL_INTERVAL=30

# Detection mode: 'watch' or 'poll' (default: watch)
FB_DETECTION_MODE=watch

# Run browser in headless mode (default: true)
# Set to false for initial authentication
FB_HEADLESS=true

# Publish operation timeout in seconds (default: 60)
FB_PUBLISH_TIMEOUT=60

# Page load timeout in seconds (default: 30)
FB_PAGE_LOAD_TIMEOUT=30

# Number of retry attempts (default: 3)
FB_RETRY_ATTEMPTS=3

# Delay between retries in seconds (default: 5)
FB_RETRY_DELAY=5

# =============================================================================
# GLOBAL OPTIONS
# =============================================================================

# Enable dry-run mode globally (default: false)
# When true, no files are written, only previews
DRY_RUN=false

# Enable verbose logging globally (default: false)
VERBOSE=false

# =============================================================================
# DEVELOPMENT / DEBUG
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# Python path for development
PYTHONPATH=src
